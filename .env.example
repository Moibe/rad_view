# Copia este archivo a `.env` (NO se commitea). Comentarios siempre en su propia línea:
# `node --env-file` (db:migrate, db:seed:admin) deja pegado al valor lo que va al final.

# Archivo SQLite
DATABASE_URL=./local.db

# Solo en el server (adapter-node lee PORT/HOST/ORIGIN; en local manda vite.config.ts: 4900).
# Server de CSI: dev = 4901, prod = 4902.
# PORT=4901
# HOST=0.0.0.0
# Con http:// (entrada por IP, sin TLS) la cookie de sesión NO va Secure; si fuera https:// sí.
# ORIGIN=http://<ip-del-server>:4901

# Cuenta admin que crea `npm run db:seed:admin` la primera vez (vacías = admin/admin).
ADMIN_USER=
ADMIN_PASSWORD=
